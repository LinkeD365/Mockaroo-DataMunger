{
  "name": "@linked365/pptb-mockaroo-data-munger",
  "version": "1.0.1",
  "displayName": "Mockaroo Data Munger",
  "description": "A tool to mock data from Mockaroo into your Dataverse tables",
  "main": "index.html",
  "author": "LinkeD365",
  "license": "MIT",
  "icon": "mockaroomungerlogo.svg",
  "features": {
    "connections": 1,
    "minAPI": "1.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "contributors": [
    {
      "name": "LinkeD365",
      "url": "https://github.com/LinkeD365"
    }
  ],
  "cspExceptions": {
    "connect-src": [
      {
        "domain": "https://api.mockaroo.com",
        "exceptionReason": "Mockaroo is used only to generate synthetic data from the configured schema. No existing Dataverse records are sent to this endpoint."
      }
    ]
  },
  "configurations": {
    "repository": "https://github.com/LinkeD365/Mockaroo-DataMunger",
    "website": "https://linked365.blog",
    "readmeUrl": "https://raw.githubusercontent.com/LinkeD365/Mockaroo-DataMunger/refs/heads/main/README.md"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LinkeD365/Mockaroo-DataMunger"
  },
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest run",
    "dev": "vite",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "finalize-package": "npm shrinkwrap"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.72.8",
    "@fluentui/react-icons": "^2.0.316",
    "ag-grid-community": "^35.0.0",
    "ag-grid-react": "^35.0.0",
    "mobx": "^6.15.0",
    "mobx-react": "^9.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@pptb/types": "^1.2.7",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^7.1.11",
    "vitest": "^4.1.12"
  },
  "files": [
    "dist",
    "assets/mockaroo-data-munger-banner.png",
    "assets/mockaroo-data-munger-screenshot.png",
    "IMPLEMENTATION.md",
    "npm-shrinkwrap.json"
  ]
}
